{
  "version": "0.4",
  "title": "Diamond — Charity Donations",
  "type": "section",
  "content": [
    {
      "id": "dmdsec-charity",
      "elType": "container",
      "settings": {
        "content_width": "boxed",
        "boxed_width": { "unit": "px", "size": 1280 },
        "padding": { "unit": "px", "top": "64", "right": "0", "bottom": "64", "left": "0", "isLinked": false },
        "background_background": "classic",
        "background_color": "#F6F6F6"
      },
      "elements": [
        {
          "id": "dmdsec-charity-card",
