            { "id": "dmdsec-charity-label", "elType": "widget", "widgetType": "heading", "settings": { "title": "RAISED FOR CHARITY", "header_size": "div", "title_color": "rgba(255,255,255,0.9)", "typography_typography": "custom", "typography_font_size": { "unit": "px", "size": 16 }, "typography_text_transform": "uppercase", "typography_letter_spacing": { "unit": "px", "size": 1.5 }, "align": "center" }, "elements": [] }
          ]
        },
        { "id": "dmdsec-charity-sc", "elType": "widget", "widgetType": "shortcode", "settings": { "shortcode": "[raffle_charities columns=\"3\"]" }, "elements": [] }
      ]
    }
