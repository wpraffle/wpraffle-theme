{
  "version": "0.4",
  "title": "WPRaffle Theme — Hero Section",
  "type": "section",
  "content": [
    {
      "id": "dmdsec-hero",
      "elType": "container",
      "settings": {
        "content_width": "boxed",
        "boxed_width": { "unit": "px", "size": 1280 },
        "min_height": { "unit": "px", "size": 520 },
        "flex_align_items": "center",
        "padding": { "unit": "px", "top": "88", "right": "0", "bottom": "88", "left": "0", "isLinked": false },
        "background_background": "classic",
        "background_color": "#2C2C2C",
        "css_classes": "wpr-hero"
      },
      "elements": [
        {
          "id": "dmdsec-hero-inner",
          "elType": "container",
          "settings": { "content_width": { "unit": "px", "size": 720 } },
          "elements": [
            { "id": "dmdsec-hero-eb", "elType": "widget", "widgetType": "heading", "settings": { "title": "LUXURY PRIZE COMPETITIONS", "header_size": "div", "title_color": "rgba(255,255,255,0.85)", "typography_typography": "custom", "typography_font_size": { "unit": "px", "size": 13 }, "typography_text_transform": "uppercase", "typography_letter_spacing": { "unit": "px", "size": 2 } }, "elements": [] },
            { "id": "dmdsec-hero-h", "elType": "widget", "widgetType": "heading", "settings": { "title": "Win incredible prizes <span style=\"color:#E4678A\">every week</span>", "header_size": "h1", "title_color": "#FFFFFF", "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_size": { "unit": "px", "size": 60 }, "typography_font_weight": "800" }, "elements": [] },
            { "id": "dmdsec-hero-lead", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<p style=\"color:rgba(255,255,255,0.9);font-size:18px\">Low fixed odds, instant payouts and 100% of ticket sales donated to charity.</p>" }, "elements": [] },
            {
              "id": "dmdsec-hero-btns",
              "elType": "container",
              "settings": { "flex_direction": "row", "gap": { "unit": "px", "size": 16 }, "padding": { "unit": "px", "top": "24", "right": "0", "bottom": "0", "left": "0", "isLinked": false } },
              "elements": [
                { "id": "dmdsec-hero-btn1", "elType": "widget", "widgetType": "button", "settings": { "text": "Enter Competitions", "link": { "url": "/shop" }, "selected_icon": { "value": "fas fa-arrow-right", "library": "fa-solid" }, "icon_align": "right", "background_color": "#E4678A", "text_color": "#FFFFFF", "border_radius": { "unit": "px", "size": 999 }, "button_padding": { "unit": "px", "top": "14", "right": "32", "bottom": "14", "left": "32", "isLinked": false } }, "elements": [] },
                { "id": "dmdsec-hero-btn2", "elType": "widget", "widgetType": "button", "settings": { "text": "See Recent Winners", "link": { "url": "#winners" }, "background_color": "rgba(255,255,255,0)", "text_color": "#FFFFFF", "border_border": "solid", "border_color": "#FFFFFF", "border_radius": { "unit": "px", "size": 999 }, "button_padding": { "unit": "px", "top": "14", "right": "32", "bottom": "14", "left": "32", "isLinked": false } }, "elements": [] }
              ]
            }
          ]
        }
      ]
    }
  ]
}
