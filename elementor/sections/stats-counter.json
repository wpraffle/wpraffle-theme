{
  "version": "0.4",
  "title": "WPRaffle Theme — Stats Counter",
  "type": "section",
  "content": [
    {
      "id": "dmdsec-stats",
      "elType": "container",
      "settings": {
        "content_width": "boxed",
        "boxed_width": { "unit": "px", "size": 1280 },
        "padding": { "unit": "px", "top": "56", "right": "0", "bottom": "56", "left": "0", "isLinked": false },
        "background_background": "classic",
        "background_color": "#2C2C2C",
        "css_classes": "wpr-stats"
      },
      "elements": [
        { "id": "dmdsec-stats-h", "elType": "widget", "widgetType": "heading", "settings": { "title": "By the Numbers", "header_size": "h2", "title_color": "#FFFFFF", "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_size": { "unit": "px", "size": 36 }, "align": "center" }, "elements": [] },
        {
          "id": "dmdsec-stats-grid",
          "elType": "container",
          "settings": { "flex_direction": "row", "gap": { "unit": "px", "size": 24 }, "padding": { "unit": "px", "top": "24", "right": "0", "bottom": "0", "left": "0", "isLinked": false } },
          "elements": [
            {
              "id": "dmdsec-stats-1",
              "elType": "container",
              "settings": { "flex_align_items": "center", "text_align": "center", "padding": { "unit": "px", "size": 24 } },
              "elements": [
                { "id": "dmdsec-stats-1n", "elType": "widget", "widgetType": "counter", "settings": { "ending_number": 12400, "suffix": "+", "title": "Winners", "title_color": "rgba(255,255,255,0.85)", "number_color": "#FFFFFF", "typography_number_typography": "custom", "typography_number_font_family": "Montserrat", "typography_number_font_size": { "unit": "px", "size": 44 }, "typography_number_font_weight": "800" }, "elements": [] }
              ]
            },
            {
              "id": "dmdsec-stats-2",
              "elType": "container",
              "settings": { "flex_align_items": "center", "text_align": "center", "padding": { "unit": "px", "size": 24 } },
              "elements": [
                { "id": "dmdsec-stats-2n", "elType": "widget", "widgetType": "counter", "settings": { "starting_number": 0, "ending_number": 2800000, "prefix": "£", "thousands_separator": "yes", "title": "Raised for Charity", "title_color": "rgba(255,255,255,0.85)", "number_color": "#E4678A", "typography_number_typography": "custom", "typography_number_font_family": "Montserrat", "typography_number_font_size": { "unit": "px", "size": 44 }, "typography_number_font_weight": "800" }, "elements": [] }
              ]
            },
            {
              "id": "dmdsec-stats-3",
              "elType": "container",
              "settings": { "flex_align_items": "center", "text_align": "center", "padding": { "unit": "px", "size": 24 } },
              "elements": [
                { "id": "dmdsec-stats-3n", "elType": "widget", "widgetType": "counter", "settings": { "starting_number": 0, "ending_number": 49, "suffix": "★", "decimals": 1, "title": "Average Rating", "title_color": "rgba(255,255,255,0.85)", "number_color": "#63DD92", "typography_number_typography": "custom", "typography_number_font_family": "Montserrat", "typography_number_font_size": { "unit": "px", "size": 44 }, "typography_number_font_weight": "800" }, "elements": [] }
              ]
            }
          ]
        }
      ]
    }
  ]
}
