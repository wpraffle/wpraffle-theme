              "settings": {
                "source": "menu",
                "menu": "primary",
                "layout": "horizontal",
                "submenu_indicator": "classic",
                "color_menu_item": "#2C2C2C",
                "color_menu_item_hover": "#E4678A",
                "color_menu_item_active": "#E4678A",
                "pointer_color_menu_item_hover": "#E4678A",
                "typography_typography": "custom",
                "typography_font_family": "Montserrat",
                "typography_font_size": { "unit": "px", "size": 15 },
                "typography_font_weight": "600",
                "padding_horizontal_menu_item": { "unit": "px", "size": 16 },
                "pointer": "underline",
                "animation_floating": "fade"
              },
              "elements": []
            }
          ]
        },
        {
          "id": "dmdhdr1c",
          "elType": "container",
          "settings": { "flex_direction": "row", "flex_align_items": "center", "flex_justify_content": "flex-end", "gap": { "unit": "px", "size": 12 }, "width": "auto" },
          "elements": [
            {
              "id": "dmdhdr1c1",
              "elType": "widget",
              "widgetType": "icon",
              "settings": { "selected_icon": { "value": "fas fa-magnifying-glass", "library": "fa-solid" }, "icon_color": "#2C2C2C", "size": { "unit": "px", "size": 18 }, "css_classes": "diamond-icon-btn" },
              "elements": []
            },
            {
              "id": "dmdhdr1c2",
              "elType": "widget",
              "widgetType": "icon-list",
              "settings": {
                "view": "inline",
                "icon_list": [
                  { "_id": "a1", "text": "My Account", "selected_icon": { "value": "far fa-user", "library": "fa-regular" }, "link": { "url": "/my-account", "is_external": "", "nofollow": "" } },
                  { "_id": "a2", "text": "Cart", "selected_icon": { "value": "fas fa-bag-shopping", "library": "fa-solid" }, "link": { "url": "/cart", "is_external": "", "nofollow": "" } }
                ],
                "icon_color": "#2C2C2C",
                "text_color": "#2C2C2C",
                "css_classes": "diamond-header__actions"
              },
              "elements": []
            }
          ]
        }
      ]
    }
