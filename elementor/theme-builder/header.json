{
  "version": "0.4",
  "title": "Diamond Header",
  "type": "header",
  "page_settings": {
    "document_type": "header",
    "location": "header",
    "conditions": [
      { "type": "include", "condition": "all" }
    ]
  },
  "content": [
    {
      "id": "dmdtop1",
      "elType": "container",
      "settings": {
        "flex_direction": "row",
        "content_width": "boxed",
        "boxed_width": { "unit": "px", "size": 1280 },
        "flex_justify_content": "space-between",
        "flex_align_items": "center",
        "padding": { "unit": "px", "top": "8", "right": "0", "bottom": "8", "left": "0", "isLinked": false },
        "background_background": "classic",
        "background_color": "#2C2C2C",
        "css_classes": "diamond-topbar"
      },
      "elements": [
        {
          "id": "dmdtop1a",
          "elType": "container",
          "settings": { "flex_direction": "row", "flex_align_items": "center", "gap": { "unit": "px", "size": 8 }, "width": "auto" },
          "elements": [
            {
              "id": "dmdtop1a1",
              "elType": "widget",
              "widgetType": "icon",
              "settings": { "selected_icon": { "value": "fas fa-bolt", "library": "fa-solid" }, "icon_color": "#63DD92", "size": { "unit": "px", "size": 14 } },
              "elements": []
            },
            {
              "id": "dmdtop1a2",
              "elType": "widget",
              "widgetType": "heading",
              "settings": { "title": "Instant payouts — pay yourself out 24/7 direct to your bank", "header_size": "div", "title_color": "#FFFFFF", "typography_typography": "custom", "typography_font_size": { "unit": "px", "size": 13 }, "typography_font_weight": "500" },
              "elements": []
            }
          ]
        },
        {
          "id": "dmdtop1b",
          "elType": "container",
          "settings": { "flex_direction": "row", "flex_align_items": "center", "gap": { "unit": "px", "size": 16 }, "width": "auto" },
          "elements": [
            {
              "id": "dmdtop1b1",
              "elType": "widget",
              "widgetType": "nav-menu",
              "settings": { "source": "menu", "menu": "primary", "submenu_indicator": "classic", "color_menu_item": "#FFFFFF", "color_menu_item_hover": "#E4678A", "pointer_color_menu_item_hover": "#E4678A", "typography_typography": "custom", "typography_font_size": { "unit": "px", "size": 13 }, "typography_font_weight": "500", "padding_horizontal_menu_item": { "unit": "px", "size": 8 } },
              "elements": []
            }
          ]
        }
      ]
    },
    {
      "id": "dmdhdr1",
      "elType": "container",
      "settings": {
        "flex_direction": "row",
        "content_width": "boxed",
        "boxed_width": { "unit": "px", "size": 1280 },
        "flex_justify_content": "space-between",
        "flex_align_items": "center",
        "min_height": { "unit": "px", "size": 88 },
        "padding": { "unit": "px", "top": "12", "right": "0", "bottom": "12", "left": "0", "isLinked": false },
        "background_background": "classic",
        "background_color": "#FFFFFF",
        "border_border": "solid",
        "border_width": { "unit": "px", "top": "0", "right": "0", "bottom": "1", "left": "0", "isLinked": false },
        "border_color": "#DEE2E6",
        "css_classes": "diamond-header",
        "position": "sticky",
        "_position": "sticky",
        "sticky": "top",
        "sticky_on": [ "desktop", "tablet", "mobile" ],
        "sticky_offset": 0
