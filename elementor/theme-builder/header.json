      "elements": [
        {
          "id": "dmdhdr1a",
          "elType": "container",
          "settings": { "flex_direction": "row", "flex_align_items": "center", "gap": { "unit": "px", "size": 12 }, "width": "auto" },
          "elements": [
            {
              "id": "dmdhdr1a1",
              "elType": "widget",
              "widgetType": "theme-site-logo",
              "settings": { "custom_logo": { "url": "" }, "size": { "unit": "px", "size": 56 }, "align": "left" },
              "elements": []
            }
          ]
        },
        {
          "id": "dmdhdr1b",
          "elType": "container",
          "settings": { "flex_direction": "row", "flex_justify_content": "center", "flex_align_items": "center" },
