{
  "version": "0.4",
  "title": "Diamond Product Archive",
  "type": "archive",
  "page_settings": {
    "document_type": "archive",
    "location": "archive",
    "conditions": [ { "type": "include", "condition": "product_archive" } ]
  },
  "content": [
    {
      "id": "dmdarc-hero",
      "elType": "container",
      "settings": {
        "content_width": "boxed",
        "boxed_width": { "unit": "px", "size": 1280 },
        "padding": { "unit": "px", "top": "56", "right": "0", "bottom": "56", "left": "0", "isLinked": false },
        "background_background": "classic",
        "background_color": "#2C2C2C",
        "flex_align_items": "center"
      },
      "elements": [
        {
          "id": "dmdarc-hero-inner",
          "elType": "container",
          "settings": { "content_width": { "unit": "px", "size": 800 }, "flex_align_items": "center" },
          "elements": [
            {
              "id": "dmdarc-eb",
              "elType": "widget",
              "widgetType": "heading",
              "settings": { "title": "LIVE NOW", "header_size": "div", "title_color": "rgba(255,255,255,0.85)", "typography_typography": "custom", "typography_font_size": { "unit": "px", "size": 13 }, "typography_text_transform": "uppercase", "typography_letter_spacing": { "unit": "px", "size": 2 }, "align": "center" },
              "elements": []
            },
            {
              "id": "dmdarc-title",
              "elType": "widget",
              "widgetType": "theme-archive-title",
              "settings": { "title_color": "#FFFFFF", "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_size": { "unit": "px", "size": 44 }, "typography_font_weight": "800", "align": "center" },
              "elements": []
            },
            {
              "id": "dmdarc-sub",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": { "editor": "<p style=\"text-align:center;color:rgba(255,255,255,0.85)\">Limited tickets, guaranteed draws, instant payouts.</p>" },
              "elements": []
            }
          ]
        }
      ]
    },
    {
      "id": "dmdarc-products",
      "elType": "container",
      "settings": {
        "content_width": "boxed",
        "boxed_width": { "unit": "px", "size": 1280 },
        "padding": { "unit": "px", "top": "48", "right": "0", "bottom": "48", "left": "0", "isLinked": false }
      },
      "elements": [
        {
          "id": "dmdarc-loop",
          "elType": "widget",
          "widgetType": "woocommerce-products",
          "settings": { "paginate": "yes", "columns": 3, "rows": 4, "orderby": "popularity" },
          "elements": []
        }
      ]
    }
  ]
}
