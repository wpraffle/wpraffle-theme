{
  "version": "0.4",
  "title": "WPRaffle Cart",
  "type": "wp-page",
  "page_settings": {
    "document_type": "cart",
    "conditions": [ { "type": "include", "condition": "url", "url": "/cart" } ]
  },
  "content": [
    {
      "id": "dmdcart-wrap",
      "elType": "container",
      "settings": {
        "content_width": "boxed",
        "boxed_width": { "unit": "px", "size": 1280 },
        "padding": { "unit": "px", "top": "64", "right": "0", "bottom": "64", "left": "0", "isLinked": false },
        "flex_align_items": "center"
      },
      "elements": [
        { "id": "dmdcart-eb", "elType": "widget", "widgetType": "heading", "settings": { "title": "YOUR CART", "header_size": "div", "title_color": "#E4678A", "typography_typography": "custom", "typography_font_size": { "unit": "px", "size": 13 }, "typography_text_transform": "uppercase", "typography_letter_spacing": { "unit": "px", "size": 2 }, "align": "center" }, "elements": [] },
        { "id": "dmdcart-h", "elType": "widget", "widgetType": "heading", "settings": { "title": "Cart", "header_size": "h1", "title_color": "#2C2C2C", "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_size": { "unit": "px", "size": 44 }, "typography_font_weight": "800", "align": "center" }, "elements": [] },
        { "id": "dmdcart-sc", "elType": "widget", "widgetType": "shortcode", "settings": { "shortcode": "[woocommerce_cart]" }, "elements": [] }
      ]
    }
  ]
}
